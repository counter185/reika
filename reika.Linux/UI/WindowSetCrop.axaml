<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:reika.Linux.UI"
        mc:Ignorable="d"
        x:Class="reika.Linux.UI.WindowSetCrop"
        Classes="reikaWindow"
        Title="reika: set video crop" MinHeight="400" Height="435" MinWidth="560" Width="560">
    <Grid Margin="10">
        <DockPanel>
			<DockPanel LastChildFill="False" DockPanel.Dock="Bottom">
				<Rectangle DockPanel.Dock="Top" Height="30"/>
				<StackPanel Orientation="Vertical" DockPanel.Dock="Right">
					<DockPanel Margin="0,0,0,5" LastChildFill="True">
						<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
							<TextBox x:Name="Input_FitAspectX" Classes="reikaTextBox" Text="16" MinWidth="35" Width="35" Height="30"/>
							<Label Content=":" VerticalContentAlignment="Center" Foreground="White"/>
							<TextBox x:Name="Input_FitAspectY" Classes="reikaTextBox" Text="9" MinWidth="35" Width="35" Height="30"/>
						</StackPanel>
						<StackPanel Orientation="Vertical" DockPanel.Dock="Right">
							<Button x:Name="Button_FitAspect" Margin="5,0,0,0" Classes="reikaButton" Height="30" HorizontalAlignment="Stretch" Content="Fit" Click="Button_FitAspect_Click"/>
							<Button x:Name="Button_FitCurrentAspect" Margin="5,0,0,0" Classes="reikaButton" Height="30" HorizontalAlignment="Stretch" Content="Fit (current)" Click="Button_FitCurrentAspect_Click"/>
						</StackPanel>
					</DockPanel>
					<Button x:Name="Button_Center" Margin="0,0,0,5" Classes="reikaButton" DockPanel.Dock="Right" Width="180" Content="Center" Click="Button_Center_Click"/>
					<Button x:Name="Button_Apply" Classes="reikaButton" Width="180" Height="40" Content="Apply" Click="Button_Apply_Click"/>
				</StackPanel>
				<local:UIInputFieldWithName DockPanel.Dock="Left" x:Name="Input_CropArg" InputFieldName="Crop" Width="274" VerticalContentAlignment="Bottom"/>
				<Label Foreground="#808080" FontStyle="Italic" FontSize="10" VerticalContentAlignment="Bottom" Content="width:height:x:y" />
			</DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                <DockPanel DockPanel.Dock="Left" LastChildFill="True">
                    <Rectangle Height="20" DockPanel.Dock="Top"/>
                    <Rectangle Height="20" DockPanel.Dock="Bottom"/>
                    <Slider Classes="reikaSlider" x:Name="Slider_Left" Orientation="Vertical" DockPanel.Dock="Top" ValueChanged="SliderMoved" Maximum="1" Value="1"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Right" LastChildFill="True">
                    <Rectangle Height="20" DockPanel.Dock="Top"/>
                    <Rectangle Height="20" DockPanel.Dock="Bottom"/>
                    <Slider Classes="reikaSlider" x:Name="Slider_Right" Orientation="Vertical" DockPanel.Dock="Top" ValueChanged="SliderMoved" Maximum="1" Value="0"/>
                </DockPanel>
                <Slider Classes="reikaSlider" x:Name="Slider_Top" Orientation="Horizontal" DockPanel.Dock="Top" Height="20" ValueChanged="SliderMoved" Maximum="1" Value="0"/>
                <Slider Classes="reikaSlider" x:Name="Slider_Bottom" Orientation="Horizontal" DockPanel.Dock="Bottom" Height="20" ValueChanged="SliderMoved" Maximum="1" Value="1"/>
                <Grid>
                    <Image x:Name="Image_Preview"/>
                    <Canvas x:Name="Canvas_Preview" DockPanel.Dock="Bottom"/>
                </Grid>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
