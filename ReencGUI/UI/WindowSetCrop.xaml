<llocal:DarkWindow x:Class="ReencGUI.UI.WindowSetCrop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReencGUI.UI"
        xmlns:llocal="clr-namespace:ReencGUI"
        mc:Ignorable="d"
        Style="{StaticResource ReencWindowStyle}"
        Title="reika: set video crop" MinHeight="324" MinWidth="504" Height="454" Width="527">
    <Grid Margin="10">
        <DockPanel>
            <DockPanel LastChildFill="False" DockPanel.Dock="Bottom">
                <Rectangle DockPanel.Dock="Top" Height="30"/>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Right">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBox x:Name="Input_FitAspectX" Style="{StaticResource ReencTextBoxStyle}" Text="16" Width="25" Height="20"/>
                            <Label Content=":" Foreground="White"/>
                            <TextBox x:Name="Input_FitAspectY" Style="{StaticResource ReencTextBoxStyle}" Text="9" Width="25" Height="20"/>
                        </StackPanel>
                        <Button x:Name="Button_FitAspect" Margin="5,0,0,0" Style="{StaticResource ReencButtonStyle}" DockPanel.Dock="Right" Height="20" Content="Fit" Click="Button_FitAspect_Click"/>
                    </DockPanel>
                    <Button x:Name="Button_Center" Margin="0,0,0,5" Style="{StaticResource ReencButtonStyle}" DockPanel.Dock="Right" Width="130" Height="20" Content="Center" Click="Button_Center_Click"/>
                    <Button x:Name="Button_Apply" Style="{StaticResource ReencButtonStyle}"  Width="130" Height="30" Content="Apply" Click="Button_Apply_Click"/>
                </StackPanel>
                <local:UIInputFieldWithName DockPanel.Dock="Left" x:Name="Input_CropArg" InputFieldName="Crop" Width="274" VerticalContentAlignment="Bottom"/>
                <Label Foreground="#808080" FontStyle="Italic" FontSize="10" VerticalContentAlignment="Bottom" Content="width:height:x:y" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                <DockPanel DockPanel.Dock="Left" LastChildFill="True">
                    <Rectangle Height="20" DockPanel.Dock="Top"/>
                    <Rectangle Height="20" DockPanel.Dock="Bottom"/>
                    <Slider Style="{DynamicResource ReencSliderStyle}" x:Name="Slider_Left" Orientation="Vertical" DockPanel.Dock="Top" ValueChanged="SliderMoved" Maximum="1" Value="1"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Right" LastChildFill="True">
                    <Rectangle Height="20" DockPanel.Dock="Top"/>
                    <Rectangle Height="20" DockPanel.Dock="Bottom"/>
                    <Slider Style="{DynamicResource ReencSliderStyle}" x:Name="Slider_Right" Orientation="Vertical" DockPanel.Dock="Top" ValueChanged="SliderMoved" Maximum="1" Value="0"/>
                </DockPanel>
                <Slider Style="{DynamicResource ReencSliderStyle}" x:Name="Slider_Top" Orientation="Horizontal" DockPanel.Dock="Top" Height="20" ValueChanged="SliderMoved" Maximum="1" Value="0"/>
                <Slider Style="{DynamicResource ReencSliderStyle}" x:Name="Slider_Bottom" Orientation="Horizontal" DockPanel.Dock="Bottom" Height="20" ValueChanged="SliderMoved" Maximum="1" Value="1"/>
                <Grid>
                    <Image x:Name="Image_Preview"/>
                    <Canvas x:Name="Canvas_Preview" DockPanel.Dock="Bottom"/>
                </Grid>
            </DockPanel>
        </DockPanel>
    </Grid>
</llocal:DarkWindow>
